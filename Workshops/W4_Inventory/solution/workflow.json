{
  "name": "W4-เฝ้าระวังสต๊อก-Solution",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8-17 * * 1-5"
            }
          ]
        }
      },
      "id": "n01-schedule",
      "name": "Schedule (ทุก 1 ชม. 8-17 น. จ.-ศ.)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_YOUR_SPREADSHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "inventory"
        },
        "options": {}
      },
      "id": "n02-sheets-read",
      "name": "Sheets: อ่าน inventory",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [460, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_SHEETS_CRED_ID",
          "name": "Google Sheets - Workshop"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "qty-below-min",
              "leftValue": "={{ Number($json.qty) }}",
              "rightValue": "={{ Number($json.min_qty) }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n03-if",
      "name": "IF: qty < min_qty?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "n04-loop",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://notify-api.line.me/api/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "=\n🚨 สต๊อกใกล้หมด!\nรายการ: {{ $json.item }}\nคงเหลือ: {{ $json.qty }} {{ $json.unit }} (จุดสั่ง: {{ $json.min_qty }})\nผู้รับผิดชอบ: {{ $json.responsible }}\nSKU: {{ $json.sku }}"
            }
          ]
        },
        "options": {}
      },
      "id": "n05-http-line",
      "name": "HTTP Request (LINE Notify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_LINE_CRED_ID",
          "name": "LINE Notify - KU Workshop"
        }
      }
    }
  ],
  "connections": {
    "Schedule (ทุก 1 ชม. 8-17 น. จ.-ศ.)": {
      "main": [
        [
          {
            "node": "Sheets: อ่าน inventory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sheets: อ่าน inventory": {
      "main": [
        [
          {
            "node": "IF: qty < min_qty?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: qty < min_qty?": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Loop Over Items": {
      "main": [
        [],
        [
          {
            "node": "HTTP Request (LINE Notify)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (LINE Notify)": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok"
  },
  "versionId": "ku-workshop-2026-05-27",
  "meta": {
    "templateCreatedBy": "Amornpan Phornchaicharoen — KU Workshop 2026",
    "description": "KU Workshop 4: Schedule → Google Sheets → IF (qty < min_qty) → Loop → LINE Notify. Replace 3 credentials + Spreadsheet ID after import. For dev/test, switch Schedule from cron to 'Every 1 Minute'."
  },
  "tags": [
    {
      "name": "ku-workshop-2026",
      "id": "ku-w4"
    }
  ]
}
